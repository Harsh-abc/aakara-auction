// backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────
model User {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  username     String  @unique @db.VarChar(50)
  email        String  @unique @db.VarChar(255)
  phone        String? @unique @db.VarChar(20)
  passwordHash String  @db.VarChar(255)

  roleId BigInt
  role   Role   @relation(fields: [roleId], references: [id])

  status UserStatus @default(PENDING_VERIFICATION)

  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  phoneVerified   Boolean   @default(false)
  phoneVerifiedAt DateTime?

  lastLoginAt         DateTime?
  lastLoginIp         String?   @db.Inet
  passwordChangedAt   DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  profile       UserProfile?
  sessions      UserSession[]
  loginAttempts LoginAttempt[]

  kyc UserKyc?

  kycVerifiedRecords        UserKyc[]             @relation("KycVerifier")
  kycDocumentsVerified      UserKycDocument[]     @relation("KycDocumentVerifier")
  kycVerificationsPerformed UserKycVerification[] @relation("KycVerificationPerformer")

  auctionsCreated       Auction[]
  itemsCurrentlyWinning AuctionItem[]          @relation("AuctionItemCurrentBidder")
  auctionParticipations AuctionParticipant[]
  participantsApproved  AuctionParticipant[]   @relation("ParticipantApprover")
  auctionStatusChanges  AuctionStatusHistory[] @relation("AuctionStatusChanger")
  auctionsWon           AuctionWinner[]        @relation("AuctionItemWinner")

  bids     Bid[]
  autoBids AutoBid[]

  @@index([roleId])
  @@index([status])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
  DEACTIVATED
}

model UserProfile {
  id BigInt @id @default(autoincrement())

  userId BigInt @unique
  user   User   @relation(fields: [userId], references: [id])

  firstName   String?
  lastName    String?
  displayName String?
  avatarUrl   String?
  bio         String?

  dateOfBirth DateTime?
  gender      Gender?

  address String?
  city    String?
  state   String?
  country String?
  pincode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

// ─────────────────────────────────────────────
// RBAC
// ─────────────────────────────────────────────

model Role {
  id           BigInt  @id @default(autoincrement())
  name         String  @unique
  description  String?
  isSystemRole Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          BigInt  @id @default(autoincrement())
  name        String  @unique
  description String?
  module      String
  action      String

  createdAt DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       BigInt
  permissionId BigInt

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────
// SESSIONS / LOGIN HISTORY
// ─────────────────────────────────────────────

model UserSession {
  id BigInt @id @default(autoincrement())

  userId BigInt
  user   User   @relation(fields: [userId], references: [id])

  refreshTokenHash String  @unique
  ipAddress        String?
  userAgent        String?
  deviceName       String?

  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model LoginAttempt {
  id BigInt @id @default(autoincrement())

  userId BigInt?
  user   User?   @relation(fields: [userId], references: [id])

  email     String
  ipAddress String?
  userAgent String?

  success       Boolean
  failureReason String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([createdAt])
  @@map("login_attempts")
}

// ─────────────────────────────────────────────
// KYC
// ─────────────────────────────────────────────

model UserKyc {
  id BigInt @id @default(autoincrement())

  userId BigInt @unique
  user   User   @relation(fields: [userId], references: [id])

  kycType KycType
  status  KycStatus @default(PENDING)

  submittedAt     DateTime?
  verifiedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  verifiedBy BigInt?
  verifier   User?   @relation("KycVerifier", fields: [verifiedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents     UserKycDocument[]
  verifications UserKycVerification[]

  @@index([status])
  @@index([verifiedBy])
  @@map("user_kyc")
}

enum KycType {
  INDIVIDUAL
  BUSINESS
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

model UserKycDocument {
  id BigInt @id @default(autoincrement())

  kycId   BigInt
  userKyc UserKyc @relation(fields: [kycId], references: [id])

  documentType   DocumentType
  documentNumber String?

  fileUrl  String
  fileName String
  mimeType String
  fileSize Int

  status          DocumentStatus @default(PENDING)
  rejectionReason String?

  verifiedAt DateTime?
  verifiedBy BigInt?
  verifier   User?     @relation("KycDocumentVerifier", fields: [verifiedBy], references: [id])

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verifications UserKycVerification[]

  @@index([kycId])
  @@index([status])
  @@index([verifiedBy])
  @@map("user_kyc_documents")
}

enum DocumentType {
  PASSPORT
  DRIVERS_LICENSE
  NATIONAL_ID
  AADHAAR
  PAN_CARD
  UTILITY_BILL
  BANK_STATEMENT
  BUSINESS_REGISTRATION
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model UserKycVerification {
  id BigInt @id @default(autoincrement())

  kycId   BigInt
  userKyc UserKyc @relation(fields: [kycId], references: [id])

  documentId BigInt
  document   UserKycDocument @relation(fields: [documentId], references: [id])

  action VerificationAction
  status DocumentStatus

  performedBy BigInt?
  performer   User?   @relation("KycVerificationPerformer", fields: [performedBy], references: [id])

  reason   String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([kycId])
  @@index([documentId])
  @@index([performedBy])
  @@map("user_kyc_verifications")
}

enum VerificationAction {
  SUBMITTED
  REVIEWED
  APPROVED
  REJECTED
  RESUBMITTED
  EXPIRED
}

model Category {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  name        String
  slug        String  @unique
  description String?
  imageUrl    String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subCategories SubCategory[]
  items         AuctionItem[]

  @@map("categories")
}

model SubCategory {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  categoryId BigInt
  category   Category @relation(fields: [categoryId], references: [id])

  name        String
  slug        String
  description String?
  imageUrl    String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items AuctionItem[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@map("sub_categories")
}

enum AuctionType {
  LIVE
  FLOOR
  HYBRID
}

enum AuctionStatus {
  DRAFT
  SCHEDULED
  PREVIEW
  LIVE
  PAUSED
  ENDED
  SETTLED
  CANCELLED
}

model Auction {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  title         String
  slug          String  @unique
  description   String?
  coverImageUrl String?

  auctionType AuctionType   @default(FLOOR)
  status      AuctionStatus @default(DRAFT)

  startTime            DateTime
  endTime              DateTime
  previewStartAt       DateTime?
  registrationRequired Boolean   @default(true)
  registrationDeadline DateTime?

  timezone String @default("Asia/Kolkata")
  currency String @default("INR")

  isOnline Boolean @default(true)
  venue    String?

  termsAndConditions String?

  createdBy BigInt
  creator   User   @relation(fields: [createdBy], references: [id])

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  items         AuctionItem[]
  rules         AuctionRule[]
  participants  AuctionParticipant[]
  statusHistory AuctionStatusHistory[]
  extensions    AuctionExtension[]
  winners       AuctionWinner[]

  @@index([status])
  @@index([startTime])
  @@index([endTime])
  @@index([createdBy])
  @@map("auctions")
}

enum ItemStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  SOLD
  UNSOLD
  PASSED
  WITHDRAWN
}

model AuctionItem {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  auctionId BigInt
  auction   Auction @relation(fields: [auctionId], references: [id])

  categoryId BigInt
  category   Category @relation(fields: [categoryId], references: [id])

  subCategoryId BigInt?
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])

  itemNumber  Int
  title       String
  description String?

  artistName      String?
  medium          String?
  dimensions      String?
  yearCreated     String?
  provenance      String?
  conditionReport String?

  startingPrice Decimal  @db.Decimal(12, 2)
  reservePrice  Decimal? @db.Decimal(12, 2)
  estimateLow   Decimal? @db.Decimal(12, 2)
  estimateHigh  Decimal? @db.Decimal(12, 2)

  currentBid      Decimal? @db.Decimal(12, 2)
  currentBidderId BigInt?
  currentBidder   User?    @relation("AuctionItemCurrentBidder", fields: [currentBidderId], references: [id])
  bidCount        Int      @default(0)

  status ItemStatus @default(DRAFT)

  scheduledStartAt DateTime?
  scheduledEndAt   DateTime?

  shippingInfo String?
  isFeatured   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images     AuctionImage[]
  documents  AuctionDocument[]
  extensions AuctionExtension[]
  winner     AuctionWinner?
  bids       Bid[]
  autoBids   AutoBid[]

  @@unique([auctionId, itemNumber])
  @@index([auctionId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([status])
  @@index([currentBidderId])
  @@map("auction_items")
}

model AuctionImage {
  id BigInt @id @default(autoincrement())

  itemId BigInt
  item   AuctionItem @relation(fields: [itemId], references: [id])

  url          String
  thumbnailUrl String?
  caption      String?
  sortOrder    Int     @default(0)
  isPrimary    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([itemId])
  @@map("auction_images")
}

enum AuctionDocumentType {
  CERTIFICATE_OF_AUTHENTICITY
  PROVENANCE
  APPRAISAL
  INSURANCE
  OTHER
}

model AuctionDocument {
  id BigInt @id @default(autoincrement())

  itemId BigInt
  item   AuctionItem @relation(fields: [itemId], references: [id])

  documentType AuctionDocumentType @default(OTHER)
  fileUrl      String
  fileName     String
  mimeType     String
  fileSize     Int
  description  String?

  createdAt DateTime @default(now())

  @@index([itemId])
  @@map("auction_documents")
}

enum RuleType {
  BID_INCREMENT
  BUYER_PREMIUM
  EXTENSION_TRIGGER
  REGISTRATION_DEPOSIT
  MIN_PARTICIPANTS
}

enum RuleValueType {
  FIXED
  PERCENTAGE
}

model AuctionRule {
  id BigInt @id @default(autoincrement())

  auctionId BigInt
  auction   Auction @relation(fields: [auctionId], references: [id])

  ruleType  RuleType
  valueType RuleValueType @default(FIXED)

  rangeMin Decimal? @db.Decimal(12, 2)
  rangeMax Decimal? @db.Decimal(12, 2)
  value    Decimal  @db.Decimal(12, 2)

  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([auctionId])
  @@index([ruleType])
  @@map("auction_rules")
}

enum ParticipantStatus {
  PENDING
  APPROVED
  REJECTED
  BANNED
}

model AuctionParticipant {
  id BigInt @id @default(autoincrement())

  auctionId BigInt
  auction   Auction @relation(fields: [auctionId], references: [id])

  userId BigInt
  user   User   @relation(fields: [userId], references: [id])

  paddleNumber String?
  status       ParticipantStatus @default(PENDING)

  registeredAt DateTime  @default(now())
  approvedAt   DateTime?
  approvedBy   BigInt?
  approver     User?     @relation("ParticipantApprover", fields: [approvedBy], references: [id])

  depositRequired Boolean  @default(false)
  depositAmount   Decimal? @db.Decimal(12, 2)
  depositPaid     Boolean  @default(false)

  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([auctionId, userId])
  @@index([auctionId])
  @@index([userId])
  @@index([status])
  @@map("auction_participants")
}

model AuctionStatusHistory {
  id BigInt @id @default(autoincrement())

  auctionId BigInt
  auction   Auction @relation(fields: [auctionId], references: [id])

  fromStatus AuctionStatus?
  toStatus   AuctionStatus

  changedBy BigInt?
  changer   User?   @relation("AuctionStatusChanger", fields: [changedBy], references: [id])

  reason String?

  createdAt DateTime @default(now())

  @@index([auctionId])
  @@index([createdAt])
  @@map("auction_status_history")
}

model AuctionExtension {
  id BigInt @id @default(autoincrement())

  auctionId BigInt
  auction   Auction @relation(fields: [auctionId], references: [id])

  itemId BigInt
  item   AuctionItem @relation(fields: [itemId], references: [id])

  originalEndTime  DateTime
  extendedEndTime  DateTime
  extensionSeconds Int

  triggeredByBidId BigInt?
  triggeredByBid   Bid?    @relation(fields: [triggeredByBidId], references: [id])

  reason String?

  createdAt DateTime @default(now())

  @@index([auctionId])
  @@index([itemId])
  @@map("auction_extensions")
}

enum WinnerPaymentStatus {
  PENDING
  PAID
  OVERDUE
  REFUNDED
  CANCELLED
}

model AuctionWinner {
  id BigInt @id @default(autoincrement())

  auctionId BigInt
  auction   Auction @relation(fields: [auctionId], references: [id])

  itemId BigInt      @unique
  item   AuctionItem @relation(fields: [itemId], references: [id])

  winnerId BigInt
  winner   User   @relation("AuctionItemWinner", fields: [winnerId], references: [id])

  winningBidId BigInt? @unique
  winningBid   Bid?    @relation(fields: [winningBidId], references: [id])

  finalHammerPrice   Decimal @db.Decimal(12, 2)
  buyerPremiumAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmountDue     Decimal @db.Decimal(12, 2)

  paymentStatus WinnerPaymentStatus @default(PENDING)
  paymentDueAt  DateTime?
  wonAt         DateTime            @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([auctionId])
  @@index([winnerId])
  @@index([paymentStatus])
  @@map("auction_winners")
}

enum BidStatus {
  PLACED
  WINNING
  OUTBID
  WON
  LOST
  CANCELLED
  RETRACTED
}

enum BidSource {
  MANUAL
  PROXY
}

model Bid {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  itemId BigInt
  item   AuctionItem @relation(fields: [itemId], references: [id])

  bidderId BigInt
  bidder   User   @relation(fields: [bidderId], references: [id])

  amount Decimal   @db.Decimal(12, 2)
  source BidSource @default(MANUAL)
  status BidStatus @default(PLACED)

  ipAddress String?
  userAgent String?

  placedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  extensionsTriggered AuctionExtension[]
  wonAuctionItem      AuctionWinner?

  @@index([itemId])
  @@index([bidderId])
  @@index([itemId, amount])
  @@index([status])
  @@map("bids")
}

model AutoBid {
  id BigInt @id @default(autoincrement())

  itemId BigInt
  item   AuctionItem @relation(fields: [itemId], references: [id])

  bidderId BigInt
  bidder   User   @relation(fields: [bidderId], references: [id])

  maxAmount Decimal @db.Decimal(12, 2)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, bidderId])
  @@index([itemId])
  @@index([bidderId])
  @@map("auto_bids")
}
