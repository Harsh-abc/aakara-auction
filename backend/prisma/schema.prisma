generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        BigInt                 @id @default(autoincrement())
  uuid                      String                 @unique @default(uuid()) @db.Uuid
  username                  String                 @unique @db.VarChar(50)
  email                     String                 @unique @db.VarChar(255)
  phone                     String?                @unique @db.VarChar(20)
  passwordHash              String                 @db.VarChar(255)
  roleId                    BigInt
  status                    UserStatus             @default(PENDING_VERIFICATION)
  emailVerified             Boolean                @default(false)
  emailVerifiedAt           DateTime?
  phoneVerified             Boolean                @default(false)
  phoneVerifiedAt           DateTime?
  lastLoginAt               DateTime?
  lastLoginIp               String?                @db.Inet
  passwordChangedAt         DateTime?
  failedLoginAttempts       BigInt                    @default(0)
  lockedUntil               DateTime?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  deletedAt                 DateTime?
  itemsCurrentlyWinning     AuctionItem[]          @relation("AuctionItemCurrentBidder")
  participantsApproved      AuctionParticipant[]   @relation("ParticipantApprover")
  auctionParticipations     AuctionParticipant[]
  auctionStatusChanges      AuctionStatusHistory[] @relation("AuctionStatusChanger")
  auctionsWon               AuctionWinner[]        @relation("AuctionItemWinner")
  auctionsCreated           Auction[]
  autoBids                  AutoBid[]
  bids                      Bid[]
  loginAttempts             LoginAttempt[]
  kyc                       UserKyc?
  kycVerifiedRecords        UserKyc[]              @relation("KycVerifier")
  kycDocumentsVerified      UserKycDocument[]      @relation("KycDocumentVerifier")
  kycVerificationsPerformed UserKycVerification[]  @relation("KycVerificationPerformer")
  profile                   UserProfile?
  sessions                  UserSession[]
  role                      Role                   @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@index([status])
  @@map("users")
}

model UserProfile {
  id          BigInt    @id @default(autoincrement())
  userId      BigInt    @unique
  firstName   String?
  lastName    String?
  displayName String?
  avatarUrl   String?
  bio         String?
  dateOfBirth DateTime?
  gender      Gender?
  address     String?
  city        String?
  state       String?
  country     String?
  pincode     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id])

  @@map("user_profiles")
}

model Role {
  id              BigInt           @id @default(autoincrement())
  name            String           @unique
  description     String?
  isSystemRole    Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Permission {
  id              BigInt           @id @default(autoincrement())
  name            String           @unique
  description     String?
  module          String
  action          String
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       BigInt
  permissionId BigInt
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserSession {
  id               BigInt    @id @default(autoincrement())
  userId           BigInt
  refreshTokenHash String    @unique
  ipAddress        String?
  userAgent        String?
  deviceName       String?
  expiresAt        DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model LoginAttempt {
  id            BigInt   @id @default(autoincrement())
  userId        BigInt?
  email         String
  ipAddress     String?
  userAgent     String?
  success       Boolean
  failureReason String?
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([email])
  @@index([createdAt])
  @@map("login_attempts")
}

model UserKyc {
  id              BigInt                @id @default(autoincrement())
  userId          BigInt                @unique
  kycType         KycType
  status          KycStatus             @default(PENDING)
  submittedAt     DateTime?
  verifiedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  verifiedBy      BigInt?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  user            User                  @relation(fields: [userId], references: [id])
  verifier        User?                 @relation("KycVerifier", fields: [verifiedBy], references: [id])
  documents       UserKycDocument[]
  verifications   UserKycVerification[]

  @@index([status])
  @@index([verifiedBy])
  @@map("user_kyc")
}

model UserKycDocument {
  id              BigInt                @id @default(autoincrement())
  kycId           BigInt
  documentType    DocumentType
  documentNumber  String?
  fileUrl         String
  fileName        String
  mimeType        String
  fileSize        BigInt
  status          DocumentStatus        @default(PENDING)
  rejectionReason String?
  verifiedAt      DateTime?
  verifiedBy      BigInt?
  expiresAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  userKyc         UserKyc               @relation(fields: [kycId], references: [id])
  verifier        User?                 @relation("KycDocumentVerifier", fields: [verifiedBy], references: [id])
  verifications   UserKycVerification[]

  @@index([kycId])
  @@index([status])
  @@index([verifiedBy])
  @@map("user_kyc_documents")
}

model UserKycVerification {
  id          BigInt             @id @default(autoincrement())
  kycId       BigInt
  documentId  BigInt
  action      VerificationAction
  status      DocumentStatus
  performedBy BigInt?
  reason      String?
  metadata    Json?
  createdAt   DateTime           @default(now())
  document    UserKycDocument    @relation(fields: [documentId], references: [id])
  userKyc     UserKyc            @relation(fields: [kycId], references: [id])
  performer   User?              @relation("KycVerificationPerformer", fields: [performedBy], references: [id])

  @@index([kycId])
  @@index([documentId])
  @@index([performedBy])
  @@map("user_kyc_verifications")
}

model Category {
  id            BigInt        @id @default(autoincrement())
  uuid          String        @unique @default(uuid()) @db.Uuid
  name          String
  slug          String        @unique
  description   String?
  imageUrl      String?
  isActive      Boolean       @default(true)
  sortOrder     BigInt           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         AuctionItem[]
  subCategories SubCategory[]
  auctions      Auction[]

  @@map("categories")
}

model SubCategory {
  id          BigInt        @id @default(autoincrement())
  uuid        String        @unique @default(uuid()) @db.Uuid
  categoryId  BigInt
  name        String
  slug        String
  description String?
  imageUrl    String?
  isActive    Boolean       @default(true)
  sortOrder   BigInt           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       AuctionItem[]
  category    Category      @relation(fields: [categoryId], references: [id])
  auctions    Auction[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@map("sub_categories")
}

model Auction {
  id                   BigInt                 @id @default(autoincrement())
  uuid                 String                 @unique @default(uuid()) @db.Uuid
  title                String
  slug                 String                 @unique
  description          String?
  short_description    String?
  coverImageUrl        String?
  auctionType          AuctionType            @default(FLOOR)
  status               AuctionStatus          @default(DRAFT)
  startTime            DateTime
  endTime              DateTime
  startDate            DateTime
  endDate              DateTime
  previewStartAt       DateTime?
  registrationRequired Boolean                @default(true)
  registrationStarts   DateTime
  registrationDeadline DateTime?
  timezone             String                 @default("Asia/Kolkata")
  currencyId           BigInt
  currency             Currency               @relation(fields: [currencyId], references: [id])
  isOnline             Boolean                @default(true)
  venue                String?
  termsAndConditions   String?
  categoryId           BigInt
  subCategoryId        BigInt?
  createdBy            BigInt
  publishedAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?
  extensions           AuctionExtension[]
  items                AuctionItem[]
  participants         AuctionParticipant[]
  rules                AuctionRule[]
  statusHistory        AuctionStatusHistory[]
  winners              AuctionWinner[]
  category             Category               @relation(fields: [categoryId], references: [id])
  subCategory          SubCategory?           @relation(fields: [subCategoryId], references: [id])
  creator              User                   @relation(fields: [createdBy], references: [id])
  tags                 AuctionTagRelation[]
  auctionFees          AuctionFee[]
  shippingStrategy     ShippingStrategy       @default(SHIPPING_CALCULATED_SEPARATELY)
  visibility           AuctionVisibility      @default(REGISTERED_USERS_ONLY)

  @@index([status])
  @@index([startTime])
  @@index([endTime])
  @@index([createdBy])
  @@index([categoryId])
  @@index([subCategoryId])
  @@map("auctions")
}

model Currency {
  id        BigInt   @id @default(autoincrement())
  code      String   @unique @db.VarChar(3)
  name      String
  symbol    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auctions     Auction[]
  auctionItems AuctionItem[]

  @@map("currencies")
}

model AuctionTag {
  id   BigInt @id @default(autoincrement())
  name String @unique
  slug String @unique

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auctions AuctionTagRelation[]

  @@map("auction_tags")
}

model AuctionTagRelation {
  auctionId BigInt
  tagId     BigInt

  auction Auction @relation(fields: [auctionId], references: [id])

  tag AuctionTag @relation(fields: [tagId], references: [id])

  @@id([auctionId, tagId])
  @@index([auctionId])
  @@index([tagId])
  @@map("auction_tag_relations")
}

model AuctionFee {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Uuid

  auctionId BigInt

  feeType AuctionFeeType

  name String

  calculationType FeeCalculationType

  value Decimal @db.Decimal(15, 2)

  description String?

  isActive Boolean @default(true)

  sortOrder BigInt @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([auctionId])
  @@index([feeType])
  @@map("auction_fees")
}

model AuctionItem {
  id        BigInt @id @default(autoincrement())
  uuid      String @unique @default(uuid()) @db.Uuid
  auctionId BigInt

  itemNumber       BigInt
  title            String
  description      String?
  artistName       String?
  medium           String?
  dimensions       String?
  yearCreated      String?
  provenance       String?
  conditionReport  String?
  startingPrice    Decimal            @db.Decimal(12, 2)
  reservePrice     Decimal?           @db.Decimal(12, 2)
  estimateLow      Decimal?           @db.Decimal(12, 2)
  estimateHigh     Decimal?           @db.Decimal(12, 2)
  currentBid       Decimal?           @db.Decimal(12, 2)
  currentBidderId  BigInt?
  bidCount         BigInt                @default(0)
  status           ItemStatus         @default(DRAFT)
  scheduledStartAt DateTime?
  scheduledEndAt   DateTime?
  shippingInfo     String?
  isFeatured       Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  documents        AuctionDocument[]
  extensions       AuctionExtension[]
  images           AuctionImage[]
  auction          Auction            @relation(fields: [auctionId], references: [id])

  currentBidder User? @relation("AuctionItemCurrentBidder", fields: [currentBidderId], references: [id])

  winner        AuctionWinner?
  autoBids      AutoBid[]
  bids          Bid[]
  category      Category?      @relation(fields: [categoryId], references: [id])
  categoryId    BigInt?
  subCategory   SubCategory?   @relation(fields: [subCategoryId], references: [id])
  subCategoryId BigInt?
  currency      Currency?      @relation(fields: [currencyId], references: [id])
  currencyId    BigInt?

  @@unique([auctionId, itemNumber])
  @@index([auctionId])
  @@index([status])
  @@index([currentBidderId])
  @@map("auction_items")
}

model AuctionImage {
  id           BigInt      @id @default(autoincrement())
  itemId       BigInt
  url          String
  thumbnailUrl String?
  caption      String?
  sortOrder    BigInt         @default(0)
  isPrimary    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  item         AuctionItem @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@map("auction_images")
}

model AuctionDocument {
  id           BigInt              @id @default(autoincrement())
  itemId       BigInt
  documentType AuctionDocumentType @default(OTHER)
  fileUrl      String
  fileName     String
  mimeType     String
  fileSize     BigInt
  description  String?
  createdAt    DateTime            @default(now())
  item         AuctionItem         @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@map("auction_documents")
}

model AuctionRule {
  id          BigInt        @id @default(autoincrement())
  auctionId   BigInt
  ruleType    RuleType
  valueType   RuleValueType @default(FIXED)
  rangeMin    Decimal?      @db.Decimal(12, 2)
  rangeMax    Decimal?      @db.Decimal(12, 2)
  value       Decimal       @db.Decimal(12, 2)
  description String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  auction     Auction       @relation(fields: [auctionId], references: [id])

  @@index([auctionId])
  @@index([ruleType])
  @@map("auction_rules")
}

model AuctionParticipant {
  id              BigInt            @id @default(autoincrement())
  auctionId       BigInt
  userId          BigInt
  paddleNumber    String?
  status          ParticipantStatus @default(PENDING)
  registeredAt    DateTime          @default(now())
  approvedAt      DateTime?
  approvedBy      BigInt?
  depositRequired Boolean           @default(false)
  depositAmount   Decimal?          @db.Decimal(12, 2)
  depositPaid     Boolean           @default(false)
  rejectionReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  approver        User?             @relation("ParticipantApprover", fields: [approvedBy], references: [id])
  auction         Auction           @relation(fields: [auctionId], references: [id])
  user            User              @relation(fields: [userId], references: [id])

  @@unique([auctionId, userId])
  @@index([auctionId])
  @@index([userId])
  @@index([status])
  @@map("auction_participants")
}

model AuctionStatusHistory {
  id         BigInt         @id @default(autoincrement())
  auctionId  BigInt
  fromStatus AuctionStatus?
  toStatus   AuctionStatus
  changedBy  BigInt?
  reason     String?
  createdAt  DateTime       @default(now())
  auction    Auction        @relation(fields: [auctionId], references: [id])
  changer    User?          @relation("AuctionStatusChanger", fields: [changedBy], references: [id])

  @@index([auctionId])
  @@index([createdAt])
  @@map("auction_status_history")
}

model AuctionExtension {
  id               BigInt      @id @default(autoincrement())
  auctionId        BigInt
  itemId           BigInt
  originalEndTime  DateTime
  extendedEndTime  DateTime
  extensionSeconds BigInt
  triggeredByBidId BigInt?
  reason           String?
  createdAt        DateTime    @default(now())
  auction          Auction     @relation(fields: [auctionId], references: [id])
  item             AuctionItem @relation(fields: [itemId], references: [id])
  triggeredByBid   Bid?        @relation(fields: [triggeredByBidId], references: [id])

  @@index([auctionId])
  @@index([itemId])
  @@map("auction_extensions")
}

model AuctionWinner {
  id                 BigInt              @id @default(autoincrement())
  auctionId          BigInt
  itemId             BigInt              @unique
  winnerId           BigInt
  winningBidId       BigInt?             @unique
  finalHammerPrice   Decimal             @db.Decimal(12, 2)
  buyerPremiumAmount Decimal             @default(0) @db.Decimal(12, 2)
  totalAmountDue     Decimal             @db.Decimal(12, 2)
  paymentStatus      WinnerPaymentStatus @default(PENDING)
  paymentDueAt       DateTime?
  wonAt              DateTime            @default(now())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  auction            Auction             @relation(fields: [auctionId], references: [id])
  item               AuctionItem         @relation(fields: [itemId], references: [id])
  winner             User                @relation("AuctionItemWinner", fields: [winnerId], references: [id])
  winningBid         Bid?                @relation(fields: [winningBidId], references: [id])

  @@index([auctionId])
  @@index([winnerId])
  @@index([paymentStatus])
  @@map("auction_winners")
}

model Bid {
  id                  BigInt             @id @default(autoincrement())
  uuid                String             @unique @default(uuid()) @db.Uuid
  itemId              BigInt
  bidderId            BigInt
  amount              Decimal            @db.Decimal(12, 2)
  source              BidSource          @default(MANUAL)
  status              BidStatus          @default(PLACED)
  ipAddress           String?
  userAgent           String?
  placedAt            DateTime           @default(now())
  createdAt           DateTime           @default(now())
  extensionsTriggered AuctionExtension[]
  wonAuctionItem      AuctionWinner?
  bidder              User               @relation(fields: [bidderId], references: [id])
  item                AuctionItem        @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([bidderId])
  @@index([itemId, amount])
  @@index([status])
  @@map("bids")
}

model AutoBid {
  id        BigInt      @id @default(autoincrement())
  itemId    BigInt
  bidderId  BigInt
  maxAmount Decimal     @db.Decimal(12, 2)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  bidder    User        @relation(fields: [bidderId], references: [id])
  item      AuctionItem @relation(fields: [itemId], references: [id])

  @@unique([itemId, bidderId])
  @@index([itemId])
  @@index([bidderId])
  @@map("auto_bids")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
  DEACTIVATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum KycType {
  INDIVIDUAL
  BUSINESS
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum DocumentType {
  PASSPORT
  DRIVERS_LICENSE
  NATIONAL_ID
  AADHAAR
  PAN_CARD
  UTILITY_BILL
  BANK_STATEMENT
  BUSINESS_REGISTRATION
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationAction {
  SUBMITTED
  REVIEWED
  APPROVED
  REJECTED
  RESUBMITTED
  EXPIRED
}

enum AuctionType {
  LIVE
  FLOOR
  HYBRID
}

enum AuctionStatus {
  DRAFT
  SCHEDULED
  PREVIEW
  LIVE
  PAUSED
  ENDED
  SETTLED
  CANCELLED
}

enum ItemStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  SOLD
  UNSOLD
  PASSED
  WITHDRAWN
}

enum AuctionDocumentType {
  CERTIFICATE_OF_AUTHENTICITY
  PROVENANCE
  APPRAISAL
  INSURANCE
  OTHER
}

enum RuleType {
  BID_INCREMENT
  BUYER_PREMIUM
  EXTENSION_TRIGGER
  REGISTRATION_DEPOSIT
  MIN_PARTICIPANTS
}

enum RuleValueType {
  FIXED
  PERCENTAGE
}

enum ParticipantStatus {
  PENDING
  APPROVED
  REJECTED
  BANNED
}

enum WinnerPaymentStatus {
  PENDING
  PAID
  OVERDUE
  REFUNDED
  CANCELLED
}

enum BidStatus {
  PLACED
  WINNING
  OUTBID
  WON
  LOST
  CANCELLED
  RETRACTED
}

enum BidSource {
  MANUAL
  PROXY
}

enum AuctionFeeType {
  BUYER_PREMIUM
  PLATFORM_FEE
  TAX_GST
  PAYMENT_PROCESSING
  LATE_PAYMENT
  SHIPPING
  CUSTOM
}

enum FeeCalculationType {
  PERCENTAGE
  FIXED
}

enum ShippingStrategy {
  SHIPPING_INCLUDED
  SHIPPING_CALCULATED_SEPARATELY
  BUYER_ARRANGES_PICKUP
  ADMIN_ARRANGES_DELIVERY
}

enum AuctionVisibility {
  PUBLIC
  REGISTERED_USERS_ONLY
  PRIVATE_INVITE_ONLY
}
